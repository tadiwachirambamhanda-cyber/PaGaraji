{
  "expo": {
    "name": "PaGaraji",
    "slug": "pagaraji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "pagaraji",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7C7B",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PaGaraji uses your photos so you can show the part you are selling or looking for.",
          "cameraPermission": "PaGaraji uses the camera so you can photograph a part."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C7B",
          "image": "./assets/images/splash-icon-v2.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PaGaraji uses your location to show nearby sellers and requests on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
